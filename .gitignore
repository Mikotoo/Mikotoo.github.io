# 依赖目录
node_modules/
dist/
.astro/

# 自动装配目录：只编辑 content/、config/ 和 public/。
# snapshots/ 有意提交；仅 pnpm sync 更新项目快照。
.generated/
src/content/docs/

# public/media/ 现在是正式媒体源，必须随笔记提交。

# 本地 npm 镜像配置：每人网络环境不同，不入库（CI 用默认 registry）
.npmrc

# 分析中间数据：体积巨大，不应进 git（示例：571 MB 的稀疏矩阵导出）
**/sparse_matrix.csv
code/single_cell/**/cache/
code/single_cell/**/__pycache__/
code/single_cell/**/*.h5ad
code/single_cell/**/web_summary.html
code/single_cell/**/*.error
code/single_cell/**/*.out

# 旧 Jekyll 站点产物
_site/
.jekyll-cache/
.jekyll-metadata

# 本地预览截图
.preview/

# 杂项
.DS_Store
Thumbs.db
*.log
.env
.env.production
